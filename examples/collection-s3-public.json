{
  "type": "Collection",
  "stac_version": "1.0.0",
  "id": "collection-s3-unsigned",
  "title": "Unsigned public S3 access",
  "description": "Read a public S3 asset at a custom endpoint without credentials or request signing.",
  "license": "CC-BY-4.0",
  "stac_extensions": [
    "https://stac-extensions.github.io/authentication/v1.2.0/schema.json",
    "https://stac-extensions.github.io/storage/v2.0.0/schema.json"
  ],
  "auth:schemes": {},
  "storage:schemes": {
    "object_storage": {
      "type": "custom-s3",
      "platform": "https://objects.example.com",
      "bucket": "example-data",
      "region": "us-east-1"
    }
  },
  "extent": {
    "spatial": {
      "bbox": [
        [
          -180,
          -90,
          180,
          90
        ]
      ]
    },
    "temporal": {
      "interval": [
        [
          "2026-01-01T00:00:00Z",
          null
        ]
      ]
    }
  },
  "links": [
    {
      "href": "https://catalog.example.com/collections/collection-s3-unsigned",
      "rel": "self",
      "type": "application/json"
    }
  ],
  "assets": {
    "data": {
      "href": "s3://example-data/cubes/example.zarr",
      "type": "application/vnd+zarr",
      "roles": [
        "data"
      ],
      "storage:refs": [
        "object_storage"
      ]
    }
  }
}
